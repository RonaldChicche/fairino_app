  {
   "id": "illjfbo9yTcahI3CcQ5K",
   "type": "text",
   "x": 14,
   "y": 4369,
   "width": 597,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "M9XPH5bLHn0usrNxtRh8"
