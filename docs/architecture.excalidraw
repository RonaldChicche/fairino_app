  {
   "id": "9cV65wD3aemkJTtxRee8",
   "type": "text",
   "x": 719,
   "y": 4369,
   "width": 587,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "9Ng7qevkNOCPj07gnNC5"
