  {
   "id": "TG6tXVWcNVlkzGz0Uwew",
   "type": "text",
   "x": 2129,
   "y": 4017,
   "width": 598,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "G5tZxK9j5vuaExU0H8ZV"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1256875766,
   "version": 1,
   "versionNonce": 1887157782,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789084800000,
   "link": null,
   "locked": false,
   "text": "La hoja de compartir exige HTTPS (motivo de D21), así que en la página local el botón de\nD23 no funcionaría. ¿Solo descarga? ¿Cómo sabe el invitado que luego estará en la\nnube?\n→ Resolver en: D21, G2, G3",
   "originalText": "La hoja de compartir exige HTTPS (motivo de D21), así que en la página local el botón de\nD23 no funcionaría. ¿Solo descarga? ¿Cómo sabe el invitado que luego estará en la\nnube?\n→ Resolver en: D21, G2, G3",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 70
  },
