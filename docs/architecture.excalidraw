   "version": 1,
   "versionNonce": 802502944,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789084800000,
   "link": null,
   "locked": false,
   "text": "La HERO10 ofrece HEVC o H.264 y D7 no fija el códec. Tampoco el del archivo final, ni si\nffmpeg usa el codificador por hardware del N100, que fue el motivo de D12. Afecta\ncompatibilidad en celulares y tiempo de render.\n→ Resolver en: tarea D1, C5",
   "originalText": "La HERO10 ofrece HEVC o H.264 y D7 no fija el códec. Tampoco el del archivo final, ni si\nffmpeg usa el codificador por hardware del N100, que fue el motivo de D12. Afecta\ncompatibilidad en celulares y tiempo de render.\n→ Resolver en: tarea D1, C5",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
