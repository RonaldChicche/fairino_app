  {
   "id": "yn5SuK4ajONEVEBzOmAN",
   "type": "text",
   "x": 14,
   "y": 3984,
   "width": 539,
   "height": 25,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
