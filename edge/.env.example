# Variables de apps/edge. Copia este archivo como apps/edge/.env y reemplaza los valores.
# apps/edge/.env está en .gitignore: solo esta plantilla se versiona.

# Cloudflare R2: bucket de los videos finales, en la cuenta institucional.
# El token se crea en R2 > Manage API tokens, con permiso Object Read & Write
# limitado a este bucket. Cloudflare muestra el secreto una sola vez.
# ID de la cuenta; el endpoint S3 es https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="<ACCOUNT_ID>"
R2_ACCESS_KEY_ID="<ACCESS_KEY_ID>"
R2_SECRET_ACCESS_KEY="<SECRET_ACCESS_KEY>"
R2_BUCKET="glambot-videos"
