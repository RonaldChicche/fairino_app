# Variables de entorno de los experimentos de experiments/.
# Copia este archivo como experiments/env/.env y reemplaza los <PLACEHOLDERS> por valores reales.
# Toda la carpeta experiments/env/ está en .gitignore salvo esta plantilla: el .env no se versiona.
# En otra computadora sin el repo, `fr10` también busca ~/.config/fr10/.env

# ---------------------------------------------------------------------------
# fr10-sim: simulación del FR10 en EC2 (las lee experiments/fr10-sim/fr10)
# ---------------------------------------------------------------------------
# Región de AWS donde está la instancia
FR10_REGION="<AWS_REGION>"
# Valor del tag Name de la instancia; fr10 la busca por ese tag
FR10_NAME="<INSTANCE_NAME_TAG>"
# Clave privada SSH; solo la usan `fr10 ssh` y `fr10 setup`
FR10_PEM="<RUTA_AL_PEM>"
# Parámetro de SSM Parameter Store con la contraseña VNC (SecureString)
FR10_PASSWORD_PARAM="<SSM_PARAMETER_NAME>"
# Puerto de noVNC en la instancia
FR10_NOVNC_PORT="<NOVNC_PORT>"

# ---------------------------------------------------------------------------
# SimMachine: WebApp del controlador FAIRINO en Docker dentro de la instancia
# (las lee `fr10 webapp`)
# ---------------------------------------------------------------------------
# IP del contenedor de SimMachine en su red de Docker
FR10_SIM_IP="<SIMMACHINE_CONTAINER_IP>"
# Puerto HTTP de la WebApp en el contenedor. En esta máquina siempre se abre el 80
FR10_WEBAPP_PORT="<WEBAPP_HTTP_PORT>"
# Puerto del canal en vivo (WebSocket) de la WebApp; se abre el mismo número en esta máquina
FR10_WEBAPP_WS_PORT="<WEBAPP_WS_PORT>"
# Credenciales de la WebApp. fr10 no las usa: quedan aquí para no escribirlas en archivos versionados
FR10_WEBAPP_USER="<WEBAPP_USER>"
FR10_WEBAPP_PASSWORD="<WEBAPP_PASSWORD>"

# ---------------------------------------------------------------------------
# Instancia: `fr10 env` (y `fr10 setup`) copian estas variables a ~/fr10.env
# en la instancia; las leen scripts/02_build_ws.sh, 03_novnc.sh y 05_autostart.sh.
# FR10_NOVNC_PORT (arriba) también se copia.
# ---------------------------------------------------------------------------
# Puerto interno de x11vnc (solo escucha en localhost dentro de la instancia)
FR10_VNC_PORT="<VNC_PORT>"
# Resolución del escritorio virtual (Xvfb), en formato ANCHOxALTO
FR10_SCREEN="<ANCHOxALTO>"
# Minutos tras cada arranque hasta el apagado de seguridad (la instancia queda stopped)
FR10_AUTOSHUTDOWN_MIN="<MINUTOS>"
# Email de maintainer que 02_build_ws.sh escribe en package.xml al compilar
FR10_MAINTAINER_EMAIL="<EMAIL>"

# ---------------------------------------------------------------------------
# Referencia de infraestructura: ningún script los lee. Son los valores que
# la documentación muestra como placeholders.
# ---------------------------------------------------------------------------
AWS_ACCOUNT_ID="<AWS_ACCOUNT_ID>"
FR10_INSTANCE_ID="<INSTANCE_ID>"
FR10_SECURITY_GROUP_ID="<SG_ID>"
FR10_VPC_ID="<VPC_ID>"
FR10_KEY_PAIR_ID="<KEY_PAIR_ID>"
FR10_AMI_ID="<AMI_ID>"
