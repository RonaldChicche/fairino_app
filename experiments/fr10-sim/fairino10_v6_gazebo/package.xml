<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypenamespace="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fairino10_v6_gazebo</name>
  <version>0.1.0</version>
  <description>Simulación del FAIRINO FR10 en Gazebo Sim (Fortress) con gz_ros2_control y MoveIt2. Reemplaza la integración con Gazebo Classic.</description>
  <!-- Email genérico: 02_build_ws.sh lo reemplaza por FR10_MAINTAINER_EMAIL al compilar -->
  <maintainer email="maintainer@example.com">fr10-sim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fairino_description</exec_depend>
  <exec_depend>fairino10_v6_moveit2_config</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
